; Clock-controlled rows: only the successful request's own self ID is refreshed.
(ttl_ms 20)
(steps (())
 (()
  (at_ms 0)
  (req (room "one") (self "a") (peer "b") (next "a1") (values (()) "" "payload"))
  (res (room "one") (self "a"))
  (rows (()) "a")
  (room_count 1)
 )
 (()
  (at_ms 5)
  (req (room "one") (self "b") (peer "a") (next "b1") (values (()) "reply"))
  (res (room "one") (self "b") (next "a1") (values (()) "" "payload"))
  (rows (()) "b" "a")
  (room_count 1)
 )
 (()
  (at_ms 19)
  (req (room "one") (self "a") (next "a1"))
  (res (room "one") (self "a") (next "b1") (values (()) "reply"))
  (rows (()) "a" "b")
  (room_count 1)
 )
 ; Reading B at19 did not refresh B's expiry at25. Expiration is inclusive.
 (()
  (at_ms 25)
  (req (room "one") (self "a") (next "a1"))
  (res (room "one") (self "a"))
  (rows (()) "a")
  (room_count 1)
 )
 ; A rejected request cannot extend A's deadline from45.
 (()
  (at_ms 39)
  (req (room "one") (self "a") (next "wrong"))
  (reject +true)
  (rows (()) "a")
  (room_count 1)
 )
 (()
  (at_ms 45)
  (req (room "one") (self "a") (next "a1"))
  (reject +true)
  (rows (()))
  (room_count 0)
 )
 ; Actual full snapshots, not references or fabricated successor rows, restore the pair.
 (()
  (at_ms 46)
  (req (room "one") (self "a") (peer "b") (next "a1") (values (()) "" "payload"))
  (res (room "one") (self "a"))
  (rows (()) "a")
  (room_count 1)
 )
 (()
  (at_ms 47)
  (req (room "one") (self "b") (peer "a") (next "b1") (values (()) "reply"))
  (res (room "one") (self "b") (next "a1") (values (()) "" "payload"))
  (rows (()) "b" "a")
  (room_count 1)
 )
 (()
  (at_ms 48)
  (req (room "one") (self "a") (next "a1"))
  (res (room "one") (self "a") (next "b1") (values (()) "reply"))
  (rows (()) "a" "b")
  (room_count 1)
 )
 (()
  (at_ms 49)
  (req (room "two") (self "other"))
  (res (room "two") (self "other"))
  (rows (()) "other")
  (room_count 2)
 )
 (()
  (at_ms 67)
  (req (room "one") (self "a") (next "a1"))
  (res (room "one") (self "a"))
  (rows (()) "a")
  (room_count 2)
 )
 ; Idle rooms are reclaimed without a request to those rooms.
 (()
  (at_ms 69)
  (sweep +true)
  (room_count 1)
 )
 (()
  (at_ms 87)
  (sweep +true)
  (room_count 0)
 )
)
