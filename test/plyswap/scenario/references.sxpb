(())
; A cached [""] snapshot is NONEMPTY and can be referenced while awaiting its peer.
(()
 (req (room "reference-hit") (self "a") (peer "b") (next "a1") (values (()) ""))
 (res (room "reference-hit") (self "a"))
)
(()
 (req (room "reference-hit") (self "a") (next "a1"))
 (res (room "reference-hit") (self "a"))
)
(()
 (req (room "reference-hit") (self "a") (next "wrong"))
 (reject +true)
)
; A different room has an opening candidate, but no own snapshot for a.
(()
 (req (room "missing-own") (self "candidate"))
 (res (room "missing-own") (self "candidate"))
)
(()
 (req (room "missing-own") (self "a") (next "a1"))
 (reject +true)
)
(()
 (req (room "missing-own") (self "a") (peer "b") (next "a1") (values (()) ""))
 (res (room "missing-own") (self "a"))
)
(()
 (req (room "missing-own") (self "b") (peer "a") (next "b1") (values (()) "answer"))
 (res (room "missing-own") (self "b") (next "a1") (values (()) ""))
)
; In a fresh room both references miss; FULL requests establish the pair.
(()
 (req (room "fresh-pair") (self "a") (next "a1"))
 (reject +true)
)
(()
 (req (room "fresh-pair") (self "b") (next "b1"))
 (reject +true)
)
(()
 (req (room "fresh-pair") (self "a") (peer "b") (next "a1") (values (()) ""))
 (res (room "fresh-pair") (self "a"))
)
(()
 (req (room "fresh-pair") (self "b") (peer "a") (next "b1") (values (()) "answer"))
 (res (room "fresh-pair") (self "b") (next "a1") (values (()) ""))
)
(()
 (req (room "fresh-pair") (self "a") (next "a1"))
 (res (room "fresh-pair") (self "a") (next "b1") (values (()) "answer"))
)
; Earlier rooms retain their own independent snapshots.
(()
 (req (room "reference-hit") (self "a") (next "a1"))
 (res (room "reference-hit") (self "a"))
)
