(())  ; DATA/DATA exchange, including replayed FULL and reference requests.
(()
 (req (room "duplex") (self "Alice-0"))
 (res (room "duplex") (self "Alice-0"))
)
(()
 (req (room "duplex") (self "Bob-0"))
 (res (room "duplex") (self "Bob-0") (peer "Alice-0"))
)
(()
 (req (room "duplex") (self "Alice-0"))
 (res (room "duplex") (self "Alice-0") (peer "Bob-0"))
)
(()
 (req (room "duplex") (self "Alice-0") (peer "Bob-0") (next "Alice-1") (values (()) "hello"))
 (res (room "duplex") (self "Alice-0"))
)
(()
 (req (room "duplex") (self "Bob-0") (peer "Alice-0") (next "Bob-1") (values (()) "world"))
 (res (room "duplex") (self "Bob-0") (next "Alice-1") (values (()) "hello"))
)
(()
 (req (room "duplex") (self "Alice-0") (next "Alice-1"))
 (res (room "duplex") (self "Alice-0") (next "Bob-1") (values (()) "world"))
)
; Duplicate FULL and reference requests preserve the same result.
(()
 (req (room "duplex") (self "Bob-0") (peer "Alice-0") (next "Bob-1") (values (()) "world"))
 (res (room "duplex") (self "Bob-0") (next "Alice-1") (values (()) "hello"))
)
(()
 (req (room "duplex") (self "Bob-0") (next "Bob-1") (values (())))
 (res (room "duplex") (self "Bob-0") (next "Alice-1") (values (()) "hello"))
)
