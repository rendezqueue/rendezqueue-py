(())  ; A provisional EMPTY does not complete the peer.
(()
 (req (room "data-empty") (self "a"))
 (res (room "data-empty") (self "a"))
)
(()
 (req (room "data-empty") (self "b"))
 (res (room "data-empty") (self "b") (peer "a"))
)
(()
 (req (room "data-empty") (self "a"))
 (res (room "data-empty") (self "a") (peer "b"))
)
(()
 (req (room "data-empty") (self "a") (peer "b") (next "a1") (values (()) "payload"))
 (res (room "data-empty") (self "a"))
)
(()
 (req (room "data-empty") (self "b") (peer "a") (values (())))
 (res (room "data-empty") (self "b") (next "a1") (values (()) "payload"))
)
(()
 (req (room "data-empty") (self "a") (next "a1"))
 (res (room "data-empty") (self "a"))
)
; B seals its retained EMPTY after receiving; peer must remain present.
(()
 (req (room "data-empty") (self "b") (peer "a") (next "b1"))
 (res (room "data-empty") (self "b") (next "a1") (values (()) "payload"))
)
(()
 (req (room "data-empty") (self "a") (next "a1"))
 (res (room "data-empty") (self "a") (next "b1"))
)
; An EMPTY row cannot resolve a cached NONEMPTY reference.
(()
 (req (room "data-empty") (self "b") (next "b1"))
 (reject +true)
)
; A late provisional request cannot erase the sealed successor.
(()
 (req (room "data-empty") (self "b") (peer "a"))
 (res (room "data-empty") (self "b") (next "a1") (values (()) "payload"))
)
(()
 (req (room "data-empty") (self "a") (next "a1"))
 (res (room "data-empty") (self "a") (next "b1"))
)
