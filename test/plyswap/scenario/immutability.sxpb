(())
; Provisional EMPTY may capture DATA, but DATA and sealed EMPTY are immutable.
(()
 (req (room "immutability") (self "a") (peer "b"))
 (res (room "immutability") (self "a"))
)
(()
 (req (room "immutability") (self "a") (peer "b") (next "a1") (values (()) "frozen"))
 (res (room "immutability") (self "a"))
)
(()
 (req (room "immutability") (self "a") (peer "b") (next "a1") (values (()) "changed"))
 (reject +true)
)
(()
 (req (room "immutability") (self "a") (peer "other") (next "a1") (values (()) "frozen"))
 (reject +true)
)
(()
 (req (room "immutability") (self "a") (peer "b") (next "other") (values (()) "frozen"))
 (reject +true)
)
(()
 (req (room "immutability") (self "b") (peer "a") (next "b1"))
 (res (room "immutability") (self "b") (next "a1") (values (()) "frozen"))
)
(()
 (req (room "immutability") (self "b") (peer "a") (next "b1") (values (()) "too late"))
 (reject +true)
)
; Stale OPEN neither rewrites bound rows nor returns DATA.
(()
 (req (room "immutability") (self "a"))
 (res (room "immutability") (self "a") (peer "b"))
)
(()
 (req (room "immutability") (self "a") (next "a1"))
 (res (room "immutability") (self "a") (next "b1"))
)
; Invalid shapes and self links reject.
(()
 (req (room "unbound-data") (self "x") (values (()) "unbound"))
 (reject +true)
)
(()
 (req (room "unsealed-data") (self "x") (peer "y") (values (()) "unsealed"))
 (reject +true)
)
(()
 (req (room "self-peer") (self "x") (peer "x"))
 (reject +true)
)
(()
 (req (room "own-successor") (self "x") (peer "y") (next "x"))
 (reject +true)
)
(()
 (req (room "peer-successor") (self "x") (peer "y") (next "y"))
 (reject +true)
)
