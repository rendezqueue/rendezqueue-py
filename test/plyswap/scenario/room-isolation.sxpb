(())  ; Identical self IDs in different rooms must never discover or exchange across rooms.
(()
 (req (room "one") (self "a"))
 (res (room "one") (self "a"))
)
(()
 (req (room "two") (self "b"))
 (res (room "two") (self "b"))
)
(()
 (req (room "two") (self "a"))
 (res (room "two") (self "a") (peer "b"))
)
(()
 (req (room "one") (self "b"))
 (res (room "one") (self "b") (peer "a"))
)
(()
 (req (room "one") (self "a") (peer "b") (next "a1") (values (()) "first room"))
 (res (room "one") (self "a"))
)
(()
 (req (room "two") (self "a") (peer "b") (next "a1") (values (()) "second room"))
 (res (room "two") (self "a"))
)
(()
 (req (room "one") (self "b") (peer "a") (next "b1"))
 (res (room "one") (self "b") (next "a1") (values (()) "first room"))
)
(()
 (req (room "two") (self "b") (peer "a") (next "b1"))
 (res (room "two") (self "b") (next "a1") (values (()) "second room"))
)
; A fresh room has no reference slots; the existing rooms remain usable.
(()
 (req (room "three") (self "a") (next "a1"))
 (reject +true)
)
(()
 (req (room "one") (self "a") (next "a1"))
 (res (room "one") (self "a") (next "b1"))
)
(()
 (req (room "two") (self "a") (next "a1"))
 (res (room "two") (self "a") (next "b1"))
)
