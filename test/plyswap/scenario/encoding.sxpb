(())  ; Encoding flags lead the packet; raw and encoded requests share one room.
(()
 (req (room "encoding") (self "a"))
 (res (room "encoding") (self "a"))
)
(()
 (req (b64 7) (room "ZW5jb2Rpbmc") (self "Yg"))
 (res (b64 7) (room "ZW5jb2Rpbmc") (self "Yg") (peer "YQ"))
)
(()
 (req (b64 2) (room "encoding") (self "YQ"))
 (res (b64 2) (room "encoding") (self "YQ") (peer "Yg"))
)
(()
 (req (room "encoding") (self "a") (peer "b") (next "a1") (values (()) "hello"))
 (res (room "encoding") (self "a"))
)
(()
 (req (b64 7) (room "ZW5jb2Rpbmc") (self "Yg") (peer "YQ") (next "YjE") (values (()) "d29ybGQ"))
 (res (b64 7) (room "ZW5jb2Rpbmc") (self "Yg") (next "YTE") (values (()) "aGVsbG8"))
)
(()
 (req (b64 2) (room "encoding") (self "YQ") (next "YTE"))
 (res (b64 2) (room "encoding") (self "YQ") (next "YjE") (values (()) "world"))
)
; Replaying the same snapshot without b64 does not change its binding or values.
(()
 (req (room "encoding") (self "b") (peer "a") (next "b1") (values (()) "world"))
 (res (room "encoding") (self "b") (next "a1") (values (()) "hello"))
)
