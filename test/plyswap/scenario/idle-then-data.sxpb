(())  ; Server-only trace; test/plyswap_test.py replays these requests.
; Client callback deduplication is checked separately in test/client_test.py.

; Opening and first DATA/DATA exchange.
(()
 (req (room "conversation") (self "Alice-0"))
 (res (room "conversation") (self "Alice-0"))
)
(()
 (req (room "conversation") (self "Bob-0"))
 (res (room "conversation") (self "Bob-0") (peer "Alice-0"))
)
(()
 (req (room "conversation") (self "Alice-0"))
 (res (room "conversation") (self "Alice-0") (peer "Bob-0"))
)
(()
 (req (room "conversation") (self "Alice-0") (peer "Bob-0") (next "Alice-1") (values (()) "first from Alice"))
 (res (room "conversation") (self "Alice-0"))
)
(()
 (req (room "conversation") (self "Bob-0") (peer "Alice-0") (next "Bob-1") (values (()) "first from Bob"))
 (res (room "conversation") (self "Bob-0") (next "Alice-1") (values (()) "first from Alice"))
)
(()
 (req (room "conversation") (self "Alice-0") (next "Alice-1"))
 (res (room "conversation") (self "Alice-0") (next "Bob-1") (values (()) "first from Bob"))
)
; Idle: PREVIOUS retries replay cached replies; unsealed CURRENT stays pending.
(()
 (req (room "conversation") (self "Alice-0") (next "Alice-1"))
 (res (room "conversation") (self "Alice-0") (next "Bob-1") (values (()) "first from Bob"))
)
(()
 (req (room "conversation") (self "Alice-1") (peer "Bob-1"))
 (res (room "conversation") (self "Alice-1"))
)
(()
 (req (room "conversation") (self "Bob-0") (next "Bob-1"))
 (res (room "conversation") (self "Bob-0") (next "Alice-1") (values (()) "first from Alice"))
)
(()
 (req (room "conversation") (self "Bob-1") (peer "Alice-1"))
 (res (room "conversation") (self "Bob-1"))
)
; Repeat the idle requests: cached replies and pending responses stay the same.
(()
 (req (room "conversation") (self "Alice-0") (next "Alice-1"))
 (res (room "conversation") (self "Alice-0") (next "Bob-1") (values (()) "first from Bob"))
)
(()
 (req (room "conversation") (self "Alice-1") (peer "Bob-1"))
 (res (room "conversation") (self "Alice-1"))
)
(()
 (req (room "conversation") (self "Bob-0") (next "Bob-1"))
 (res (room "conversation") (self "Bob-0") (next "Alice-1") (values (()) "first from Alice"))
)
(()
 (req (room "conversation") (self "Bob-1") (peer "Alice-1"))
 (res (room "conversation") (self "Bob-1"))
)
; New DATA replaces Alice's provisional EMPTY under the same self ID.
(()
 (req (room "conversation") (self "Alice-1") (peer "Bob-1") (next "Alice-2") (values (()) "something new"))
 (res (room "conversation") (self "Alice-1"))
)
; Bob's provisional EMPTY poll receives Alice's DATA and sealed successor.
(()
 (req (room "conversation") (self "Bob-1") (peer "Alice-1"))
 (res (room "conversation") (self "Bob-1") (next "Alice-2") (values (()) "something new"))
)
; Until Bob publishes that seal, Alice's cached reference is still pending.
(()
 (req (room "conversation") (self "Alice-1") (next "Alice-2"))
 (res (room "conversation") (self "Alice-1"))
)
; Publishing Bob's sealed EMPTY keeps peer and replays the same DATA reply.
(()
 (req (room "conversation") (self "Bob-1") (peer "Alice-1") (next "Bob-2"))
 (res (room "conversation") (self "Bob-1") (next "Alice-2") (values (()) "something new"))
)
; next completes Alice's EMPTY response.
(()
 (req (room "conversation") (self "Alice-1") (next "Alice-2"))
 (res (room "conversation") (self "Alice-1") (next "Bob-2"))
)
