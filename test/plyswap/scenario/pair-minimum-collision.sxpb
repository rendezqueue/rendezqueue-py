(())
; A minimum self ID does not identify a pair in admitted server states.
(()
 (req (room "pair-collision") (self "b") (peer "a"))
 (res (room "pair-collision") (self "b"))
)
(()
 (req (room "pair-collision") (self "c") (peer "a"))
 (res (room "pair-collision") (self "c"))
)
; Both rows survive; newest directed candidate wins discovery.
(()
 (req (room "pair-collision") (self "a"))
 (res (room "pair-collision") (self "a") (peer "c"))
)
; Discovery does not reserve a pair: a can bind to b instead.
(()
 (req (room "pair-collision") (self "a") (peer "b"))
 (res (room "pair-collision") (self "a"))
)
(()
 (req (room "pair-collision") (self "b"))
 (res (room "pair-collision") (self "b") (peer "a"))
)
(()
 (req (room "pair-collision") (self "c"))
 (res (room "pair-collision") (self "c") (peer "a"))
)
